# i-stødet.dk (xn--i-stdet-t1a.dk) — 11ty content-site + PWA under /app/
# Hostes på websites (46.225.103.197). TLS via CF Origin-cert (Full Strict).
# Deploy af denne fil: scripts/deploy-caddy.sh (scp + ugctl caddy reload).
xn--i-stdet-t1a.dk, www.xn--i-stdet-t1a.dk {
	tls /etc/caddy/certs/xn--i-stdet-t1a.dk/origin.crt /etc/caddy/certs/xn--i-stdet-t1a.dk/origin.key

	# www → apex (301 så SEO konsoliderer på apex).
	@www host www.xn--i-stdet-t1a.dk
	redir @www https://xn--i-stdet-t1a.dk{uri} 301

	root * /var/www/xn--i-stdet-t1a.dk/current
	encode gzip zstd

	# Caddy kører ALLE header-direktiver der matcher, i fil-rækkefølge (navngivne
	# matchere sorteres ikke); sidste match vinder for samme felt. Derfor står den
	# bredeste regel (@html) FØRST og de mere specifikke bagefter. sw.js/manifest
	# matcher BÅDE @appassets og @swmanifest, så @swmanifest SKAL stå sidst for at
	# vinde (max-age=0). Rækkefølge er bevidst.

	# HTML opdateres ofte → kort cache. `*/` er suffix-match på alle mappe-URL'er
	# (/, /om/, /spar/elbil/, /app/); `*.html` dækker /404.html og /app/index.html.
	@html path *.html */
	header @html Cache-Control "public, max-age=300, must-revalidate"

	# robots.txt + sitemap.xml: en time er rigeligt friskt for crawlere.
	@crawl path /robots.txt /sitemap.xml
	header @crawl Cache-Control "public, max-age=3600"

	# PWA-moduler/ikoner: kort cache.
	@appassets path /app/*.js /app/*.png /app/*.ico /favicon.ico
	header @appassets Cache-Control "public, max-age=3600"

	# Marketing-assets (CSS/JS/billeder) er cache-bustet via ?v= → kan caches længere.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400"

	# sw.js + manifest skal være friske (ellers hænger PWA på en gammel app-skal).
	# SIDST, så den overskriver @appassets for sw.js.
	@swmanifest path /app/sw.js /app/manifest.webmanifest
	header @swmanifest Cache-Control "public, max-age=0, must-revalidate"

	# Sikkerheds-headers. >-prefix lader upstream overskrive.
	# HSTS-ramp: 300 → 86400 (nu, trin 1) → 31536000 når et døgn har kørt uden
	# problemer. Hæv først til et år når alle subdomæner med sikkerhed er HTTPS.
	# X-Frame-Options DENY: sitet og appen skal aldrig indlejres i en frame.
	# Bevidst INGEN restriktiv Content-Security-Policy: PWA'ens index.html bruger
	# inline scripts; en streng script-src ville brække appen. Tilføj først CSP
	# efter appens inline-JS er flyttet ud (uden for dette projekts scope).
	header {
		>Strict-Transport-Security "max-age=86400"
		>X-Frame-Options "DENY"
		>X-Content-Type-Options "nosniff"
		>Referrer-Policy "strict-origin-when-cross-origin"
		>Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# Same-origin-proxy til Energi Data Service. API'et sender ingen CORS-headers,
	# så PWA'en kan ikke kalde det direkte fra browseren. Appen henter nettariffer
	# (DatahubPricelist) og CO2 (CO2Emis) via /eds/dataset/…. Kun GET, kun
	# /dataset/*, ingen cookies videre. Upstreams egen Cache-Control (60 s) gælder.
	@eds {
		method GET
		path /eds/dataset/*
	}
	handle @eds {
		uri strip_prefix /eds
		reverse_proxy https://api.energidataservice.dk {
			header_up Host api.energidataservice.dk
			header_up -Cookie
			header_up -Origin
			header_up -Referer
			header_down -Set-Cookie
		}
	}

	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output file /var/log/caddy/xn--i-stdet-t1a.dk.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
	}
}
